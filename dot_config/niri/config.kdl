include "/etc/niri/config.kdl"

spawn-at-startup "tray-launch" "flatpak" "run" "--command=signal-desktop" "org.signal.Signal"
spawn-at-startup "tray-launch" "flatpak" "run" "--command=Telegram" "org.telegram.desktop" "-autostart"
spawn-at-startup "tray-launch" "flatpak" "run" "dev.vencord.Vesktop" "--start-minimized"
spawn-at-startup "tray-launch" "flatpak" "run" "--command=SyncThingy" "com.github.zocker_160.SyncThingy"
spawn-at-startup "tray-launch" "flatpak" "run" "--command=cryptomator" "org.cryptomator.Cryptomator"

screenshot-path null

hotkey-overlay {
  skip-at-startup
}

input {
  keyboard {
    xkb { layout "pt"; }
  }
}

output "DP-1" {
  scale 2.0
}

layout {
  preset-column-widths {
    proportion 0.5
    proportion 0.66667
    proportion 0.33333
    proportion 0.725
  }
}

// TODO: move to system-wide

spawn-at-startup "niri-float-sticky" "-title" "Picture-in-picture"

window-rule {
  match app-id="org.kde.plasma.emojier"
  open-floating true
  default-column-width { fixed 560; }
  default-window-height { fixed 448; }
}

window-rule {
  match app-id="steam"
  open-maximized true
}

window-rule {
  match app-id="org.inkscape.Inkscape"
  open-maximized true
}

binds {
  Mod+W { toggle-column-tabbed-display; }
  Mod+Period repeat=false { spawn "plasma-emojier"; }
  XF86Calculator { spawn "flatpak" "run" "org.kde.kcalc"; }
  Mod+Ctrl+H { consume-or-expel-window-left; }
  Mod+Ctrl+L { consume-or-expel-window-right; }
}
