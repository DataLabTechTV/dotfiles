include "/etc/niri/config.kdl"

spawn-at-startup "tray-launch" "flatpak" "run" "--command=signal-desktop" "org.signal.Signal"
spawn-at-startup "tray-launch" "flatpak" "run" "--command=Telegram" "org.telegram.desktop" "-autostart"
spawn-at-startup "tray-launch" "flatpak" "run" "dev.vencord.Vesktop" "--start-minimized"
spawn-at-startup "tray-launch" "flatpak" "run" "--command=SyncThingy" "com.github.zocker_160.SyncThingy"
spawn-at-startup "tray-launch" "flatpak" "run" "--command=cryptomator" "org.cryptomator.Cryptomator"

screenshot-path null

hotkey-overlay {
  skip-at-startup
}

input {
  keyboard {
    xkb { layout "pt"; }
  }
}

output "DP-1" {
  scale 2.0
}

layout {
  preset-column-widths {
    proportion 0.5
    proportion 0.66667
    proportion 0.33333
    proportion 0.725
  }
}

recent-windows {
  previews {
    max-height 200
  }

  highlight {
    corner-radius 16
  }
}

window-rule {
  match app-id="dev.zed.Zed"
  open-maximized true
}

window-rule {
  match app-id="dev.zed.Zed" title="^Zed — Settings$"
  open-floating true
}

window-rule {
  match app-id="org.kde.konsole"
  default-column-width { proportion 0.66667; }
}

window-rule {
  match app-id="org.gimp.GIMP"
  open-maximized true
}

window-rule {
  match app-id="org.kde.kcalc"
  open-floating true
  default-column-width { fixed 300; }
  default-window-height { fixed 420; }
}

window-rule {
  match title="^Picture-in-picture$"
  open-floating true
  open-focused false
  default-column-width { fixed 480; }
  default-window-height { fixed 270; }
  default-floating-position x=16 y=16 relative-to="bottom-right"
}

window-rule {
  match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
  default-floating-position x=-266 y=16 relative-to="top-right"
  open-focused false
}
